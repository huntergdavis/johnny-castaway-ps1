# Build output
jc_reborn
jc_reborn.exe
*.o
Makefile

# PS1 build artifacts
*.bin
*.cue
*.log
config/ps1/build_date_embedded.h
build-*/
# `build-*/` is meant for the PS1 C-build dirs (build-ps1/, build-host/).
# The lab article slug `build-farm/` collides with that rule, so explicitly
# unignore the two paths Jekyll uses for it. Without these, every edit to
# either file needs `git add -f` and CI gets surprises.
!site/lab/build-farm/
!site/lab/build-farm/**
!docs/lab/build-farm/
!docs/lab/build-farm/**
scratch/

# Scene host-capture artifacts (regenerable). The resulting pack files
# that ship on the CD are committed under generated/ps1/foreground/.
host-results/

# Per-scene PS1 regtest captures (large, regenerable via
# scripts/capture-reference-frames.sh). The Scene Explorer thumbnails
# distilled from these captures are committed under
# jc_resources/extracted/scr/SCEXPL_*.SCR.
regtest-references/

# Release ISO files are uploaded as GitHub Release assets, not Git blobs.
release/*.bin
release/*.cue

# Compiled binaries at root
/analyze_resources
/extract_resources
/test_bmp_memory
/test_disk_streaming
/scene_analyzer
/scene_analysis_output.txt

# Resource files (not distributed)
RESOURCE.MAP
RESOURCE.001
*.wav
!jc_resources/sound*.wav
dump/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Local agent state
.claude/scheduled_tasks.lock

# Zip archives
*.zip

# VLM models (multi-GB, download separately)
models/

# Python virtual environments
.venv*/

# Docker / build locks
.regtest-build.lock

# Binary library output (regenerate with build-binary-library.sh)
binary-library/

# Host build artifacts
jc_reborn-host
build-host/

# Regtest results (regenerate with regtest-scene.sh)
regtest-results/

# Python caches
__pycache__/
*.pyc
host-results

# Jekyll site build artifacts
site/_site/
site/.jekyll-cache/
site/.jekyll-metadata
site/vendor/
site/Gemfile.lock
site/.bundle/
tests/mem_region_fuzz
tests/mem_region_frag_regression
tests/mem_region_heapmap_validate
tests/mem_region_945_regression
tests/mem_sim
tests/mem_map_replay
tests/mem_real_repro
tests/mem_path_replay
